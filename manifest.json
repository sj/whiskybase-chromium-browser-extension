{
  "manifest_version": 3,
  "name": "Bottle lookup for Whiskybase",
  "version": "0.3.0",
  "description": "Spots whisky bottles on web pages and looks them up on Whiskybase. Not affiliated with or endorsed by Whiskybase.",
  "homepage_url": "https://github.com/sj/whiskybase-chromium-browser-extension",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Bottle lookup for Whiskybase",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.whiskybase.com/*",
    "https://static.whiskybase.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
